{
  "name": "@pikafish-js/rules",
  "version": "0.1.0",
  "description": "Xiangqi rules, FEN, move generation, adjudication and Chinese notation.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/official-pikafish/pikafish-js.git",
    "directory": "packages/rules"
  },
  "homepage": "https://github.com/official-pikafish/pikafish-js#readme",
  "bugs": "https://github.com/official-pikafish/pikafish-js/issues",
  "keywords": [
    "xiangqi",
    "chinese-chess",
    "rules",
    "fen",
    "move-generation",
    "notation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/copy-license.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/rules"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
