{
  "name": "pikafish-js",
  "version": "1.0.0",
  "description": "Run the Pikafish xiangqi engine in the browser via WebAssembly.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maicarons/pikafish-js.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/Maicarons/pikafish-js#readme",
  "bugs": "https://github.com/Maicarons/pikafish-js/issues",
  "keywords": [
    "xiangqi",
    "chinese-chess",
    "pikafish",
    "webassembly",
    "wasm",
    "engine",
    "nnue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker-runtime": {
      "types": "./dist/worker-runtime.d.ts",
      "import": "./dist/worker-runtime.js",
      "default": "./dist/worker-runtime.js"
    },
    "./engine.worker.js": "./dist/engine.worker.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/build-worker.mjs",
    "prepack": "node ../../scripts/copy-license.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/engine"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
